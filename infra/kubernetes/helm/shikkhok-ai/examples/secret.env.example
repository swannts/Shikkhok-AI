# Create the referenced Kubernetes Secret without committing the real values:
# kubectl -n shikkhok-production create secret generic shikkhok-ai-secrets \
#   --from-env-file=infra/kubernetes/helm/shikkhok-ai/examples/secret.env.example
# Replace every placeholder before use. Do not use this file directly in production.
MONGODB_URI=mongodb+srv://user:password@cluster.example/shikkhok_prod?retryWrites=true&w=majority
REDIS_URL=rediss://:password@redis.example:6379
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-second-random-secret-at-least-32-characters
AI_SERVICE_SECRET=replace-with-a-random-secret-at-least-32-characters
AI_HMAC_SECRET=replace-with-the-same-as-AI_SERVICE_SECRET-for-worker-api-auth
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-16-characters
LLM_API_KEY=replace-with-provider-key
EMBEDDING_API_KEY=replace-with-provider-key
QDRANT_URL=https://qdrant.example:6333
QDRANT_API_KEY=replace-with-qdrant-key-if-authenticated
FIREBASE_PROJECT_ID=replace-with-gcp-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
FIREBASE_PRIVATE_KEY=replace-with-service-account-private-key
