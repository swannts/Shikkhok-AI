# Shikkhok-AI Worker Environment Configuration Template

NODE_ENV=development
WORKER_HEALTH_PORT=3100
WORKER_CONCURRENCY=5

# Redis (shared with API service)
REDIS_URL=redis://localhost:6379

# AI Service Integration
AI_SERVICE_URL=http://localhost:8000
AI_HMAC_SECRET=change-me-to-match-api-AI_HMAC_SECRET

# FCM HTTP v1 (Firebase Admin SDK - Service Account JSON path or individual fields)
# Option 1: Service account JSON file path
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json

# Option 2: Individual fields (recommended for Kubernetes secrets)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email Transports
RESEND_API_KEY=
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=support@shikkhok.ai

# SMS Transports
SSL_WIRELESS_API_TOKEN=
SSL_WIRELESS_SID=
SSL_WIRELESS_DOMAIN=https://smsplus.sslwireless.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
