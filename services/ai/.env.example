# Shikkhok-AI Dedicated AI Service Configuration
APP_ENV=development
APP_NAME=shikkhok-ai-service
PORT=8000
HOST=0.0.0.0
ALLOW_MOCK_PROVIDERS=true

# Internal HMAC Shared Secret (Must match NestJS AI_SERVICE_SECRET)
INTERNAL_SERVICE_SECRET=dev-internal-ai-service-secret-at-least-32chars
ALLOWED_SERVICE_NAMES=["nestjs-backend","shikkhok-api"]
ALLOWED_CLOCK_SKEW_SECONDS=300

# NestJS Backend Base URL
NEST_API_BASE_URL=http://localhost:4000/api/v1

# Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Primary LLM Provider ("gemini", "mock")
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_MODEL=

# Embedding Provider ("gemini", "mock")
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# Vector Store Provider ("memory", "persistent")
VECTOR_STORE_PROVIDER=memory
VECTOR_STORE_URL=http://localhost:6333
VECTOR_STORE_API_KEY=

# Timeouts
REQUEST_TIMEOUT_SECONDS=30.0
LLM_TIMEOUT_SECONDS=20.0

# Tutor grounding mode ("hybrid", "strict")
TUTOR_GROUNDING_MODE=hybrid
