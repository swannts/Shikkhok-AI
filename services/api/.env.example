# Shikkhok-AI API Environment Configuration Template

NODE_ENV=development
PORT=4000

# Database Configuration
MONGODB_URI=mongodb://shikkhok_admin:shikkhok_secure_password@localhost:27017/shikkhok_db?authSource=admin
REDIS_URL=redis://localhost:6379

# JWT Secrets (Must be at least 16 characters long)
JWT_ACCESS_SECRET=shikkhok-development-only-access-secret-2026
JWT_REFRESH_SECRET=shikkhok-development-only-refresh-secret-2026
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Security & CORS Allowlist (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:8081
