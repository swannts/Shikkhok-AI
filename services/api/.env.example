# Shikkhok-AI API Environment Configuration Template

NODE_ENV=development
PORT=4000

# Database Configuration
MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/shikkhok_db?authSource=admin
REDIS_URL=redis://localhost:6379

# JWT Secrets (Must be at least 32 characters)
JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-char-secret
JWT_REFRESH_SECRET=change-me-to-a-random-32-plus-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Security & CORS Allowlist (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:8081

# Dedicated FastAPI AI Service Integration
AI_SERVICE_ENABLED=true
AI_SERVICE_BASE_URL=http://localhost:8000/api/v1
AI_HMAC_SECRET=generate-a-random-32-plus-char-secret-here
AI_SERVICE_TIMEOUT_MS=25000

# Payment Webhooks
PAYMENT_WEBHOOK_SECRET=generate-a-random-32-plus-char-secret-here
