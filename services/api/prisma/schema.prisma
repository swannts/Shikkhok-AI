datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id           String                @id @default(uuid())
  phoneOrEmail String                @unique
  passwordHash String
  role         String                @default("STUDENT")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  profile      StudentProfile?
  sessions     RefreshTokenSession[]
}

model StudentProfile {
  id               String                   @id @default(uuid())
  userId           String                   @unique
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  classId          String                   @default("class-8")
  className        String                   @default("Class 8")
  language         String                   @default("bn")
  medium           String                   @default("bangla")
  goal             String                   @default("exam_prep")
  overallMastery   Int                      @default(72)
  studyTimeHours   Float                    @default(14.5)
  accuracyRate     Int                      @default(78)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  lessonProgress   StudentLessonProgress[]
  chapterProgress  StudentChapterProgress[]
  subjectProgress  StudentSubjectProgress[]
  practiceSessions PracticeSession[]
  questionAttempts QuestionAttempt[]
  studyTasks       StudyTask[]
  tutorConversations TutorConversation[]
  topicMasteries   TopicMastery[]
}

model RefreshTokenSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subject {
  id              String                   @id
  classId         String                   @default("class-8")
  bnName          String
  enName          String
  icon            String
  chapterCount    Int
  lessonCount     Int
  colorBg         String
  chapters        Chapter[]
  studentProgress StudentSubjectProgress[]
  @@index([classId])
}

model Chapter {
  id               String                   @id
  subjectId        String
  subject          Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterNumber    Int
  bnTitle          String
  enTitle          String
  lessonCount      Int
  practiceSetCount Int
  lessons          Lesson[]
  studentProgress  StudentChapterProgress[]

  @@index([subjectId])
}

model Lesson {
  id               String                  @id
  chapterId        String
  chapter          Chapter                 @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title            String
  estimatedMinutes Int                     @default(15)
  blocks           Json                    // Native Json array of LessonContentBlock
  studentProgress  StudentLessonProgress[]

  @@index([chapterId])
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
  MATCHING
  MULTI_SELECT
}

model Question {
  id           String            @id @default(uuid())
  topicId      String            @default("linear-equations")
  type         QuestionType      @default(MCQ)
  questionText String
  options      Json?             // Flexible Json structure per question type (options, pairs, expected answer, etc.)
  answerConfig Json?             // Optional type-specific validation rules/acceptable tolerance/metadata
  explanation  String
  attempts     QuestionAttempt[]

  @@index([topicId])
}

model StudentSubjectProgress {
  id                String         @id @default(uuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  masteryPercentage Int            @default(0)
  updatedAt         DateTime       @updatedAt

  @@unique([studentId, subjectId])
}

model StudentChapterProgress {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chapterId  String
  chapter    Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress   Float          @default(0.0)
  updatedAt  DateTime       @updatedAt

  @@unique([studentId, chapterId])
}

model StudentLessonProgress {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean        @default(false)
  progress  Float          @default(0.0)
  updatedAt DateTime       @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId, lessonId])
}

model PracticeSession {
  id                 String            @id @default(uuid())
  studentId          String
  student            StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicTitle         String
  totalQuestions     Int
  correctAnswers     Int
  accuracyPercentage Int
  timeSpentSeconds   Int
  initialMastery     Int
  updatedMastery     Int
  weakTopics         Json              // Native Json array of weak topic strings
  createdAt          DateTime          @default(now())
  attempts           QuestionAttempt[]

  @@index([studentId, createdAt])
}

model QuestionAttempt {
  id                String          @id @default(uuid())
  studentId         String
  student           StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  practiceSessionId String?
  practiceSession   PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: SetNull)
  questionId        String
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId  String?
  responsePayload   Json?           // Extensible response payload for non-MCQ types (strings, numeric values, matching pairs)
  isCorrect         Boolean
  createdAt         DateTime        @default(now())

  @@index([studentId, createdAt])
  @@index([questionId])
}


model StudyTask {
  id              String         @id @default(uuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  subject         String
  durationMinutes Int
  completed       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([studentId, createdAt])
}

model TutorConversation {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String         @default("AI Tutor Chat")
  lessonId  String?
  topicId   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TutorMessage[]

  @@index([studentId, createdAt])
}

model TutorMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String            // 'user' | 'assistant' | 'system'
  content        String
  provider       String?           // e.g. 'GeminiProvider'
  model          String?           // e.g. 'gemini-1.5-flash'
  tokenUsage     Json?             // { promptTokens: number, completionTokens: number, totalTokens: number }
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}



model TopicMastery {
  id                String         @id @default(uuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId           String
  topicTitle        String
  masteryPercentage Int            @default(0)
  totalAttempts     Int            @default(0)
  correctAttempts   Int            @default(0)
  updatedAt         DateTime       @updatedAt

  @@unique([studentId, topicId])
}

model CurriculumDocumentChunk {
  id             String                    @id @default(uuid())
  content        String
  metadata       Json                      // Encapsulates class, subject, chapter, lesson, pageNumber, sourceBook, etc.
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime                  @default(now())
}


