datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  phoneOrEmail String                @unique
  passwordHash String
  role         String                @default("STUDENT")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  profile      StudentProfile?
  sessions     RefreshTokenSession[]
}

model StudentProfile {
  id               String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String                   @unique @db.ObjectId
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  classId          String                   @default("class-8")
  className        String                   @default("Class 8")
  language         String                   @default("bn")
  medium           String                   @default("bangla")
  goal             String                   @default("exam_prep")
  overallMastery   Int                      @default(72)
  studyTimeHours   Float                    @default(14.5)
  accuracyRate     Int                      @default(78)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  lessonProgress   StudentLessonProgress[]
  chapterProgress  StudentChapterProgress[]
  subjectProgress  StudentSubjectProgress[]
  practiceSessions PracticeSession[]
  questionAttempts QuestionAttempt[]
  studyTasks       StudyTask[]
  tutorConversations TutorConversation[]
  topicMasteries   TopicMastery[]
}

model RefreshTokenSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subject {
  id              String                   @id @map("_id")
  classId         String                   @default("class-8")
  bnName          String
  enName          String
  icon            String
  chapterCount    Int
  lessonCount     Int
  colorBg         String
  chapters        Chapter[]
  studentProgress StudentSubjectProgress[]
}

model Chapter {
  id               String                   @id @map("_id")
  subjectId        String
  subject          Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterNumber    Int
  bnTitle          String
  enTitle          String
  lessonCount      Int
  practiceSetCount Int
  lessons          Lesson[]
  studentProgress  StudentChapterProgress[]
}

model Lesson {
  id               String                  @id @map("_id")
  chapterId        String
  chapter          Chapter                 @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title            String
  estimatedMinutes Int                     @default(15)
  blocks           Json                    // Native Json array of LessonContentBlock
  studentProgress  StudentLessonProgress[]
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
  MATCHING
  MULTI_SELECT
}

model Question {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  topicId      String            @default("linear-equations")
  type         QuestionType      @default(MCQ)
  questionText String
  options      Json?             // Flexible Json structure per question type
  answerConfig Json?             // Optional type-specific validation rules
  explanation  String
  attempts     QuestionAttempt[]
}

model StudentSubjectProgress {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId         String         @db.ObjectId
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  masteryPercentage Int            @default(0)
  updatedAt         DateTime       @updatedAt

  @@unique([studentId, subjectId])
}

model StudentChapterProgress {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId  String         @db.ObjectId
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chapterId  String
  chapter    Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress   Float          @default(0.0)
  updatedAt  DateTime       @updatedAt

  @@unique([studentId, chapterId])
}

model StudentLessonProgress {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId String         @db.ObjectId
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean        @default(false)
  progress  Float          @default(0.0)
  updatedAt DateTime       @updatedAt

  @@unique([studentId, lessonId])
}

model PracticeSession {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  studentId          String            @db.ObjectId
  student            StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicTitle         String
  totalQuestions     Int
  correctAnswers     Int
  accuracyPercentage Int
  timeSpentSeconds   Int
  initialMastery     Int
  updatedMastery     Int
  weakTopics         Json              // Native Json array of weak topic strings
  createdAt          DateTime          @default(now())
  attempts           QuestionAttempt[]
}

model QuestionAttempt {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  studentId         String           @db.ObjectId
  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  practiceSessionId String?          @db.ObjectId
  practiceSession   PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: SetNull)
  questionId        String           @db.ObjectId
  question          Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId  String?
  responsePayload   Json?
  isCorrect         Boolean
  createdAt         DateTime         @default(now())
}

model StudyTask {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String         @db.ObjectId
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  subject         String
  durationMinutes Int
  completed       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model TutorConversation {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId String         @db.ObjectId
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String         @default("AI Tutor Chat")
  lessonId  String?
  topicId   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TutorMessage[]
}

model TutorMessage {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String            @db.ObjectId
  conversation   TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String            // 'user' | 'assistant' | 'system'
  content        String
  provider       String?
  model          String?
  tokenUsage     Json?
  createdAt      DateTime          @default(now())
}

model TopicMastery {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId         String         @db.ObjectId
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId           String
  topicTitle        String
  masteryPercentage Int            @default(0)
  totalAttempts     Int            @default(0)
  correctAttempts   Int            @default(0)
  updatedAt         DateTime       @updatedAt

  @@unique([studentId, topicId])
}

model CurriculumDocumentChunk {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  metadata  Json     // Encapsulates class, subject, chapter, lesson, pageNumber, sourceBook, etc.
  createdAt DateTime @default(now())
}
