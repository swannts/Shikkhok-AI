# Local Development Environment Variable Template
# Copy to .env for local docker-compose execution

# Database
POSTGRES_USER=shikkhok_user
POSTGRES_PASSWORD=shikkhok_secure_password
POSTGRES_DB=shikkhok_db
DATABASE_URL=postgresql://shikkhok_user:shikkhok_secure_password@postgres:5432/shikkhok_db?schema=public

# Redis
REDIS_URL=redis://redis:6379

# API Security
JWT_SECRET=shikkhok-development-only-jwt-secret-key-2026-min-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:8081

# AI Gateway
GEMINI_API_KEY=your_gemini_api_key_here
