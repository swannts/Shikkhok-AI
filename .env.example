# Local Development Environment Variable Template
# Copy to .env for local docker-compose execution

# Database
MONGODB_URI=mongodb://shikkhok_admin:shikkhok_secure_password@mongodb:27017/shikkhok_db?authSource=admin

# Redis
REDIS_URL=redis://redis:6379

# API Security
JWT_ACCESS_SECRET=generate-a-random-32-plus-char-secret-here
JWT_REFRESH_SECRET=generate-a-second-32-plus-char-secret-here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:8080,http://localhost:8081

# AI Service Integration
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://localhost:8000
AI_HMAC_SECRET=generate-a-random-32-plus-char-secret-here

# AI Gateway
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Optional Hugging Face Inference Providers token (server-side only).
HF_TOKEN=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct-1M:fastest
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
# Curriculum retrieval embeddings remain independent from the chat provider.
EMBEDDING_PROVIDER=gemini

# Worker
WORKER_HEALTH_PORT=3100

# FCM (optional for local dev)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
