name: Shikkhok AI Platform CI/CD Pipeline

# GitHub Actions Workflow Disabled as Requested (Manual trigger only via workflow_dispatch)
on:
  workflow_dispatch:

jobs:
  # -------------------------------------------------------------
  # 1. MOBILE APP CI (Typecheck, Lint, Format, Tests)
  # -------------------------------------------------------------
  mobile-ci:
    name: Mobile App (Typecheck, Lint, Format, Tests)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18
          cache: 'npm'
          cache-dependency-path: apps/mobile/package-lock.json

      - name: Install Mobile Dependencies
        run: |
          cd apps/mobile
          npm ci

      - name: Mobile TypeScript Check
        run: |
          cd apps/mobile
          npm run typecheck

      - name: Mobile ESLint Check
        run: |
          cd apps/mobile
          npm run lint

      - name: Mobile Format Check
        run: |
          cd apps/mobile
          npm run format:check

      - name: Mobile Jest Tests
        run: |
          cd apps/mobile
          npm test

  # -------------------------------------------------------------
  # 2. MAIN API SERVICE CI (Typecheck, Prisma, Tests, Build)
  # -------------------------------------------------------------
  api-ci:
    name: API Service (Typecheck, Prisma, Tests, Build)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'
          cache-dependency-path: services/api/package-lock.json

      - name: Install API Dependencies
        run: |
          cd services/api
          npm ci

      - name: Generate Prisma Client
        run: |
          cd services/api
          npx prisma generate

      - name: API TypeScript Check
        run: |
          cd services/api
          npx tsc --noEmit

      - name: API Jest Tests
        run: |
          cd services/api
          npm test

      - name: API Production Build
        run: |
          cd services/api
          npm run build

  # -------------------------------------------------------------
  # 3. AI GATEWAY SERVICE CI (Typecheck, Tests, Build)
  # -------------------------------------------------------------
  ai-gateway-ci:
    name: AI Gateway (Typecheck, Tests, Build)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'
          cache-dependency-path: services/ai-gateway/package-lock.json

      - name: Install AI Gateway Dependencies
        run: |
          cd services/ai-gateway
          npm ci

      - name: AI Gateway TypeScript Check
        run: |
          cd services/ai-gateway
          npx tsc --noEmit

      - name: AI Gateway Build
        run: |
          cd services/ai-gateway
          npm run build

  # -------------------------------------------------------------
  # 4. WORKER SERVICE CI (Typecheck, Build)
  # -------------------------------------------------------------
  worker-ci:
    name: Worker Service (Typecheck, Build)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install Worker Dependencies
        run: |
          cd services/worker
          npm ci || npm install

      - name: Worker Build
        run: |
          cd services/worker
          npm run build

  # -------------------------------------------------------------
  # 5. DOCKER BUILD & SECURITY SCANNING
  # -------------------------------------------------------------
  docker-build-security:
    name: Docker Build & Security Verification
    needs: [mobile-ci, api-ci, ai-gateway-ci, worker-ci]
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Verify Docker Compose Build
        run: |
          docker compose config
