{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_USE_MOCK_API": "true",
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:4000/api/v1",
        "EXPO_PUBLIC_AI_GATEWAY_URL": "http://localhost:4001/ai/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_USE_MOCK_API": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.shikkhok.ai/api/v1",
        "EXPO_PUBLIC_AI_GATEWAY_URL": "https://staging-ai.shikkhok.ai/ai/v1"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_USE_MOCK_API": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.shikkhok.ai/api/v1",
        "EXPO_PUBLIC_AI_GATEWAY_URL": "https://ai.shikkhok.ai/ai/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
